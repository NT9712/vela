// std/time — clocks and durations.

use core

const CLOCK_REALTIME: Int = 0
const CLOCK_MONOTONIC: Int = 1

fn clock(which: Int) -> Int {
    let ts = core.alloc(32, 0)
    @syscall(228, which, ts + 16)
    return @load64(ts + 16) * 1000000000 + @load64(ts + 24)
}

/// Nanoseconds since the epoch.
pub fn now_ns() -> Int {
    return clock(CLOCK_REALTIME)
}

/// Milliseconds since the epoch.
pub fn now_ms() -> Int {
    return now_ns() / 1000000
}

/// Seconds since the epoch.
pub fn now_s() -> Int {
    return now_ns() / 1000000000
}

/// A monotonic timestamp in nanoseconds, suitable for measuring elapsed time.
pub fn mono_ns() -> Int {
    return clock(CLOCK_MONOTONIC)
}

/// A broken-down UTC date and time.
pub struct DateTime {
    year: Int,
    month: Int,
    day: Int,
    hour: Int,
    minute: Int,
    second: Int,
}

/// Convert seconds-since-epoch into a UTC calendar date.
pub fn utc(secs: Int) -> DateTime {
    let mut days = secs / 86400
    let mut rem = secs % 86400
    if rem < 0 {
        rem += 86400
        days -= 1
    }
    let hour = rem / 3600
    let minute = (rem % 3600) / 60
    let second = rem % 60

    let mut year = 1970
    while true {
        let dy = days_in_year(year)
        if days < dy {
            break
        }
        days -= dy
        year += 1
    }
    let mut month = 1
    while true {
        let dm = days_in_month(year, month)
        if days < dm {
            break
        }
        days -= dm
        month += 1
    }
    return DateTime{ year: year, month: month, day: days + 1,
                     hour: hour, minute: minute, second: second }
}

/// The current UTC date and time.
pub fn now() -> DateTime {
    return utc(now_s())
}

/// True for leap years in the proleptic Gregorian calendar.
pub fn is_leap(y: Int) -> Bool {
    if y % 4 != 0 {
        return false
    }
    if y % 100 != 0 {
        return true
    }
    return y % 400 == 0
}

fn days_in_year(y: Int) -> Int {
    if is_leap(y) {
        return 366
    }
    return 365
}

fn days_in_month(y: Int, m: Int) -> Int {
    if m == 2 {
        if is_leap(y) {
            return 29
        }
        return 28
    }
    if m == 4 or m == 6 or m == 9 or m == 11 {
        return 30
    }
    return 31
}

fn pad2(n: Int) -> Str {
    if n < 10 {
        return "0" + str(n)
    }
    return str(n)
}

/// ISO 8601, e.g. `2026-08-25T22:19:21Z`.
pub fn DateTime.to_str(self) -> Str {
    return "{self.year}-{pad2(self.month)}-{pad2(self.day)}T" +
           "{pad2(self.hour)}:{pad2(self.minute)}:{pad2(self.second)}Z"
}

/// Format a nanosecond duration in human units.
pub fn duration_str(ns: Int) -> Str {
    if ns < 1000 {
        return "{ns}ns"
    }
    if ns < 1000000 {
        return "{float(ns) / 1000.0}us"
    }
    if ns < 1000000000 {
        return "{float(ns) / 1000000.0}ms"
    }
    return "{float(ns) / 1000000000.0}s"
}
