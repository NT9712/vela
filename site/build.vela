// site/build.vela — the documentation site generator.
//
// Reads the Markdown in docs/ and spec/, writes static HTML into site/public/.
// No framework, no client-side JavaScript, no web fonts: every page is one HTML
// file and one shared stylesheet.
//
// Vela code blocks are highlighted with tools/lex.vela — the same lexer the
// compiler ships — so the site cannot drift from the language it documents.

use std/io
use std/fs
use std/os
use std/path
use ../tools/lex

const SITE: Str = "Vela"
const TAGLINE: Str = "A small, fast, statically typed language that compiles straight to native x86-64 and ARM64 executables."
const REPO: Str = "https://github.com/NT9712/vela"

struct Page {
    slug: Str,
    title: Str,
    nav: Str,
    src: Str,
}

fn pages() -> [Page] {
    return [
        Page{ slug: "index", title: "Vela", nav: "Home", src: "" },
        Page{ slug: "getting-started", title: "Getting started", nav: "Start", src: "docs/getting-started.md" },
        Page{ slug: "tour", title: "Language tour", nav: "Tour", src: "docs/tour.md" },
        Page{ slug: "stdlib", title: "Standard library", nav: "Library", src: "docs/stdlib.md" },
        Page{ slug: "spec", title: "Specification", nav: "Spec", src: "spec/SPEC.md" },
        Page{ slug: "memory", title: "Memory model", nav: "Memory", src: "docs/memory.md" },
        Page{ slug: "compiler", title: "Compiler", nav: "Compiler", src: "docs/compiler.md" },
        Page{ slug: "diagnostics", title: "Diagnostics", nav: "Errors", src: "docs/diagnostics.md" },
        Page{ slug: "performance", title: "Performance", nav: "Speed", src: "docs/performance.md" },
        Page{ slug: "bootstrap", title: "Bootstrap", nav: "Bootstrap", src: "docs/bootstrap.md" },
        Page{ slug: "contributing", title: "Contributing", nav: "Contribute", src: "docs/contributing.md" },
    ]
}

fn main() -> !Void {
    let argv = os.args()
    let root = if len(argv) > 1 { argv[1] } else { ".." }
    let out = path.join([root, "site", "public"])
    fs.mkdir_all(out)?

    let ps = pages()
    for p in ps {
        let body = if p.slug == "index" { home_body(root) } else { render(fs.read_file(path.join([root, p.src]))?) }
        let html = shell(p, ps, body)
        fs.write_file(path.join([out, p.slug + ".html"]), html)?
        io.println("  {p.slug}.html  {len(html)} bytes")
    }
    fs.write_file(path.join([out, "style.css"]), fs.read_file(path.join([root, "site", "style.css"]))?)?
    fs.write_file(path.join([out, "robots.txt"]), "User-agent: *\nAllow: /\n")?
    fs.write_file(path.join([out, "sitemap.xml"]), sitemap(ps))?
    io.println("  style.css, robots.txt, sitemap.xml")
    return ok(void)
}

// -------------------------------------------------------------------- shell

fn shell(p: Page, ps: [Page], body: Str) -> Str {
    let b = buf_with(len(body) + 4096)
    b.push("<!doctype html>\n<html lang=\"en\"><head>\n")
    b.push("<meta charset=\"utf-8\">\n")
    b.push("<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n")
    b.push("<title>")
    b.push(esc(if p.slug == "index" { "{SITE} — a small, fast, native language" } else { "{p.title} · {SITE}" }))
    b.push("</title>\n")
    b.push("<meta name=\"description\" content=\"" + esc(TAGLINE) + "\">\n")
    b.push("<meta property=\"og:title\" content=\"" + esc(p.title) + "\">\n")
    b.push("<meta property=\"og:description\" content=\"" + esc(TAGLINE) + "\">\n")
    b.push("<meta name=\"color-scheme\" content=\"light dark\">\n")
    b.push("<link rel=\"stylesheet\" href=\"/style.css\">\n")
    b.push("<link rel=\"icon\" href=\"data:image/svg+xml,")
    b.push("%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E")
    b.push("%3Ctext y='13' font-size='13' font-family='monospace'%3EV%3C/text%3E%3C/svg%3E\">\n")
    b.push("</head><body>\n")

    b.push("<header><nav>")
    b.push("<a class=\"brand\" href=\"/\">vela</a>")
    for q in ps {
        if q.slug == "index" {
            continue
        }
        let cls = if q.slug == p.slug { " class=\"on\"" } else { "" }
        b.push("<a{cls} href=\"/{q.slug}\">{esc(q.nav)}</a>")
    }
    b.push("<a class=\"gh\" href=\"{REPO}\">GitHub</a>")
    b.push("</nav></header>\n")

    b.push("<main>\n")
    b.push(body)
    b.push("</main>\n")

    b.push("<footer><p>")
    b.push("<a href=\"{REPO}\">source</a> · ")
    b.push("<a href=\"{REPO}/releases/latest\">releases</a> · ")
    b.push("MIT · this site was generated by a program written in Vela")
    b.push("</p></footer>\n")
    b.push("</body></html>\n")
    return b.str()
}

fn snippet(root: Str, name: Str) -> Str {
    return fs.read_file(path.join([root, "site", "snippets", name])) ?? ""
}

fn home_body(root: Str) -> Str {
    let b = buf_with(8192)
    b.push("<section class=\"hero\">\n")
    b.push("<h1>vela</h1>\n")
    b.push("<p class=\"tag\">A small, fast, statically typed language that compiles straight to\n")
    b.push("native x86-64 and ARM64 executables — no VM, no libc, no linker.</p>\n")
    b.push(highlight_block("vela", snippet(root, "point.vela")))
    b.push("<p class=\"cta\"><a class=\"btn\" href=\"/getting-started\">Get started</a>")
    b.push("<a class=\"btn ghost\" href=\"/tour\">Take the tour</a></p>\n")
    b.push("</section>\n")

    b.push("<h2>Why</h2>\n<div class=\"grid\">\n")
    b.push(card("Simple", "The whole language is one document. Four primitive types, one reference model, no traits, no macros, no lifetimes, no implicit conversions."))
    b.push(card("Fast", "About 33,000 lines per second, source to executable. A hello-world binary is 18&nbsp;KB, starts in under a millisecond, and makes three syscalls before <code>main</code>."))
    b.push(card("Expressive", "Closures, generics, sum types, pattern matching, string interpolation, and errors as values."))
    b.push(card("Cohesive", "The collector, the collections, the formatter and the <code>vela</code> command are all written in Vela. There is no privileged layer you cannot read."))
    b.push("</div>\n")

    b.push("<h2>Install</h2>\n")
    b.push(highlight_block("console", snippet(root, "install.txt")))

    b.push("<h2>A taste</h2>\n")
    b.push(highlight_block("vela", snippet(root, "taste.vela")))

    b.push("<h2>Diagnostics are the product</h2>\n")
    b.push("<p>A compiler that only says <em>no</em> wastes your time.</p>\n")
    b.push(highlight_block("text", snippet(root, "error.txt")))

    b.push("<h2>What is actually here</h2>\n")
    b.push("<table><thead><tr><th>part</th><th>language</th><th>lines</th></tr></thead><tbody>\n")
    b.push(row("bootstrap compiler, x86-64 and ARM64 backends", "C", "12,000"))
    b.push(row("runtime: allocator, collector, strings, collections", "<b>Vela</b>", "2,900"))
    b.push(row("standard library: io, fs, os, net, json, math, …", "<b>Vela</b>", "2,050"))
    b.push(row("toolchain: formatter, docs, CLI, language server", "<b>Vela</b>", "2,600"))
    b.push(row("tests", "Vela + shell", "950"))
    b.push(row("documentation and specification", "Markdown", "3,100"))
    b.push("</tbody></table>\n")
    b.push("<p>63 test groups: golden output, diagnostics, unit tests, formatter idempotency,\n")
    b.push("the whole toolchain end to end, the language server, release packaging, a\n")
    b.push("regression corpus and randomised fuzzing.</p>\n")

    b.push("<h2>Two targets, no cross toolchain</h2>\n")
    b.push("<p>The compiler encodes the instructions and writes the ELF itself, so\n")
    b.push("cross-compiling needs nothing installed beyond <code>velac</code>.</p>\n")
    b.push(highlight_block("console", "vela build --target arm64\n" +
        "file build/hello-arm64\n" +
        "build/hello-arm64: ELF 64-bit LSB executable, ARM aarch64, statically linked\n"))

    b.push("<h2>Honest limits</h2>\n<ul>\n")
    b.push("<li><b>Linux only.</b> Two architectures, x86-64 and ARM64, both ELF64.</li>\n")
    b.push("<li><b>Single-threaded.</b> <code>std/process</code> gives parallelism through child processes.</li>\n")
    b.push("<li><b>Not self-hosted.</b> The toolchain is Vela; the compiler is still C.\n")
    b.push("<a href=\"/bootstrap\">The bootstrap page</a> says exactly what is and is not, and what remains.</li>\n")
    b.push("</ul>\n")
    return b.str()
}

fn card(title: Str, text: Str) -> Str {
    return "<div class=\"card\"><h3>{esc(title)}</h3><p>{text}</p></div>\n"
}

fn row(a: Str, b: Str, c: Str) -> Str {
    return "<tr><td>{a}</td><td>{b}</td><td class=\"n\">{c}</td></tr>\n"
}

fn sitemap(ps: [Page]) -> Str {
    let b = buf()
    b.push("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n")
    b.push("<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n")
    for p in ps {
        let loc = if p.slug == "index" { "/" } else { "/" + p.slug }
        b.push("  <url><loc>https://vela-lang.vercel.app{loc}</loc></url>\n")
    }
    b.push("</urlset>\n")
    return b.str()
}

// ----------------------------------------------------------------- markdown

fn render(md: Str) -> Str {
    let b = buf_with(len(md) * 2)
    let lines = md.lines()
    let mut i = 0
    let n = len(lines)
    while i < n {
        let line = lines[i]
        let t = line.trim()

        if t.starts_with("```") {
            let lang = t[3..len(t)].trim()
            let code = buf()
            i += 1
            while i < n and not lines[i].trim().starts_with("```") {
                code.push(lines[i])
                code.push("\n")
                i += 1
            }
            i += 1
            b.push(highlight_block(lang, code.str()))
            continue
        }

        if len(t) == 0 {
            i += 1
            continue
        }

        if t.starts_with("#") {
            let mut lvl = 0
            while lvl < len(t) and t[lvl] == '#' {
                lvl += 1
            }
            let text = t[lvl..len(t)].trim()
            let id = slugify(text)
            b.push("<h{lvl} id=\"{id}\"><a href=\"#{id}\">{inline(text)}</a></h{lvl}>\n")
            i += 1
            continue
        }

        if t == "---" or t == "***" or t == "___" {
            b.push("<hr>\n")
            i += 1
            continue
        }

        // table: a header row followed by a |---| separator
        if t.starts_with("|") and i + 1 < n and is_table_sep(lines[i + 1].trim()) {
            b.push("<table><thead><tr>")
            for c in cells(t) {
                b.push("<th>{inline(c)}</th>")
            }
            b.push("</tr></thead><tbody>\n")
            i += 2
            while i < n and lines[i].trim().starts_with("|") {
                b.push("<tr>")
                for c in cells(lines[i].trim()) {
                    b.push("<td>{inline(c)}</td>")
                }
                b.push("</tr>\n")
                i += 1
            }
            b.push("</tbody></table>\n")
            continue
        }

        if t.starts_with("- ") or t.starts_with("* ") {
            b.push("<ul>\n")
            while i < n {
                let li = lines[i].trim()
                if not (li.starts_with("- ") or li.starts_with("* ")) {
                    break
                }
                let item = buf()
                item.push(li[2..len(li)])
                i += 1
                // continuation lines are indented and not a new bullet
                while i < n and len(lines[i].trim()) > 0 and lines[i].starts_with("  ") and
                      not lines[i].trim().starts_with("- ") and not lines[i].trim().starts_with("* ") {
                    item.push(" ")
                    item.push(lines[i].trim())
                    i += 1
                }
                b.push("<li>{inline(item.str())}</li>\n")
            }
            b.push("</ul>\n")
            continue
        }

        if is_ol(t) {
            b.push("<ol>\n")
            while i < n and is_ol(lines[i].trim()) {
                let li = lines[i].trim()
                let dot = li.index_of(".")
                b.push("<li>{inline(li[dot + 1..len(li)].trim())}</li>\n")
                i += 1
            }
            b.push("</ol>\n")
            continue
        }

        if t.starts_with("> ") or t == ">" {
            b.push("<blockquote>\n")
            let q = buf()
            while i < n and lines[i].trim().starts_with(">") {
                let l = lines[i].trim()
                q.push(l[1..len(l)].trim())
                q.push(" ")
                i += 1
            }
            b.push("<p>{inline(q.str().trim())}</p>\n</blockquote>\n")
            continue
        }

        // paragraph: consume until a blank line or a block starter
        let para = buf()
        while i < n {
            let l = lines[i].trim()
            if len(l) == 0 or l.starts_with("#") or l.starts_with("```") or
               l.starts_with("|") or l.starts_with("- ") or l.starts_with("* ") or
               l.starts_with("> ") or l == "---" or is_ol(l) {
                break
            }
            if para.len() > 0 {
                para.push(" ")
            }
            para.push(l)
            i += 1
        }
        if para.len() > 0 {
            b.push("<p>{inline(para.str())}</p>\n")
        }
    }
    return b.str()
}

fn is_ol(t: Str) -> Bool {
    if len(t) < 3 {
        return false
    }
    let mut i = 0
    while i < len(t) and t[i].is_digit() {
        i += 1
    }
    return i > 0 and i < len(t) and t[i] == '.' and i + 1 < len(t) and t[i + 1] == ' '
}

fn is_table_sep(t: Str) -> Bool {
    if not t.starts_with("|") {
        return false
    }
    for c in t {
        if c != '|' and c != '-' and c != ':' and c != ' ' {
            return false
        }
    }
    return true
}

fn cells(row: Str) -> [Str] {
    let parts = row.split("|")
    let out: [Str] = []
    for i, p in parts {
        if i == 0 or i == len(parts) - 1 {
            continue
        }
        out.push(p.trim())
    }
    return out
}

fn slugify(s: Str) -> Str {
    let b = buf()
    for c in s.lower() {
        if c.is_alnum() {
            b.push_byte(c)
        } else if c == ' ' or c == '-' or c == '_' {
            if b.len() > 0 {
                b.push_byte('-')
            }
        }
    }
    let r = b.str()
    if len(r) == 0 {
        return "section"
    }
    return r
}

// --------------------------------------------------------- inline markdown

fn inline(s: Str) -> Str {
    let b = buf_with(len(s) + 32)
    let n = len(s)
    let mut i = 0
    while i < n {
        let c = s[i]

        if c == '`' {
            let mut j = i + 1
            while j < n and s[j] != '`' {
                j += 1
            }
            if j < n {
                b.push("<code>")
                b.push(esc(s[i + 1..j]))
                b.push("</code>")
                i = j + 1
                continue
            }
        }

        if c == '[' {
            let close = find_from(s, "]", i)
            if close > 0 and close + 1 < n and s[close + 1] == '(' {
                let end = find_from(s, ")", close)
                if end > 0 {
                    let text = s[i + 1..close]
                    let url = fix_link(s[close + 2..end])
                    b.push("<a href=\"{esc(url)}\">{inline(text)}</a>")
                    i = end + 1
                    continue
                }
            }
        }

        if c == '*' and i + 1 < n and s[i + 1] == '*' {
            let end = find_from(s, "**", i + 2)
            if end > 0 {
                b.push("<strong>")
                b.push(inline(s[i + 2..end]))
                b.push("</strong>")
                i = end + 2
                continue
            }
        }

        if c == '<' {
            b.push("&lt;")
            i += 1
            continue
        }
        if c == '>' {
            b.push("&gt;")
            i += 1
            continue
        }
        if c == '&' {
            b.push("&amp;")
            i += 1
            continue
        }
        b.push_byte(c)
        i += 1
    }
    return b.str()
}

fn find_from(s: Str, needle: Str, from: Int) -> Int {
    let r = s[from..len(s)].index_of(needle)
    if r < 0 {
        return -1
    }
    return from + r
}

/// Rewrite in-repo Markdown links to site routes.
fn fix_link(u: Str) -> Str {
    if u.starts_with("http") or u.starts_with("#") or u.starts_with("mailto:") {
        return u
    }
    let base = path.stem(path.base(u))
    if u.contains("SPEC") {
        return "/spec"
    }
    if u.starts_with("../examples") or u.starts_with("examples") or
       u.starts_with("../lib") or u.starts_with("lib") or
       u.starts_with("../bench") or u.starts_with("../tests") or
       u.starts_with("editor/") or u.starts_with("../editor") {
        return REPO + "/blob/main/" + u.replace("../", "")
    }
    if u.ends_with(".md") {
        return "/" + base
    }
    return REPO + "/blob/main/" + u.replace("../", "")
}

// -------------------------------------------------------- syntax highlight

fn highlight_block(lang: Str, code: Str) -> Str {
    let b = buf_with(len(code) * 2 + 64)
    b.push("<pre><code")
    if len(lang) > 0 {
        b.push(" class=\"lang-{esc(lang)}\"")
    }
    b.push(">")
    if lang == "vela" {
        b.push(highlight_vela(code))
    } else {
        b.push(esc(code))
    }
    b.push("</code></pre>\n")
    return b.str()
}

/// Colour Vela source with the compiler's own lexer, so highlighting can never
/// disagree with the language.
fn highlight_vela(src: Str) -> Str {
    let toks = lex.tokenize(src) ?? return esc(src)
    let b = buf_with(len(src) * 2)
    let mut line = 1
    let mut col = 1
    for t in toks {
        if t.is_eof() {
            break
        }
        // reproduce the whitespace the lexer skipped
        while line < t.line {
            b.push("\n")
            line += 1
            col = 1
        }
        while col < t.col {
            b.push(" ")
            col += 1
        }
        let text = t.text()
        let cls = token_class(t)
        if len(cls) == 0 {
            b.push(esc(text))
        } else {
            b.push("<span class=\"{cls}\">{esc(text)}</span>")
        }
        // advance the cursor over the token's own text
        for ch in text {
            if ch == '\n' {
                line += 1
                col = 1
            } else {
                col += 1
            }
        }
    }
    return b.str()
}

fn token_class(t: lex.Token) -> Str {
    return match t.kind {
        lex.Tok.Keyword(k) => keyword_class(k),
        lex.Tok.Str(_) => "s",
        lex.Tok.Char(_) => "s",
        lex.Tok.Int(_) => "n",
        lex.Tok.Float(_) => "n",
        lex.Tok.Comment(_) => "c",
        lex.Tok.BlockComment(_) => "c",
        lex.Tok.Doc(_) => "d",
        lex.Tok.Ident(name) => ident_class(name),
        _ => "",
    }
}

fn keyword_class(k: Str) -> Str {
    if k == "true" or k == "false" or k == "nil" or k == "self" {
        return "l"
    }
    return "k"
}

fn ident_class(name: Str) -> Str {
    if len(name) == 0 {
        return ""
    }
    let builtins = ["str", "int", "float", "byte", "bool", "len", "print",
                    "println", "panic", "assert", "assert_eq", "assert_ne",
                    "ok", "err", "err_code", "void", "buf", "buf_with"]
    if builtins.contains(name) {
        return "b"
    }
    if name[0] >= 'A' and name[0] <= 'Z' {
        return "t"
    }
    return ""
}

fn esc(s: Str) -> Str {
    if not (s.contains("<") or s.contains(">") or s.contains("&")) {
        return s
    }
    let b = buf_with(len(s) + 16)
    for c in s {
        if c == '<' {
            b.push("&lt;")
        } else if c == '>' {
            b.push("&gt;")
        } else if c == '&' {
            b.push("&amp;")
        } else {
            b.push_byte(c)
        }
    }
    return b.str()
}

// ---------------------------------------------------------------------- css

