// EXPECT:
// true true false
// q: true false
// r: true false
// nested: true false
// enum: true false
// opt: true false true
// list of structs: true false
struct P {
    a: Int,
    b: Str,
}
struct Q {
    m: {Str: Int },
}
struct R {
    l: [Int],
}
struct N {
    p: P,
    r: R,
}
enum E {
    A,
    B(Int),
    C(Str,
    Int),
}
fn main() {
    let p = P{ a: 1, b: "x" }
    let p2 = P{ a: 1, b: "x" }
    println("{p == p} {p == p2} {p == P{ a: 2, b: "x" }}")
    let q = Q{m: {"k": 1 } }
    println("q: {q == q} {q == Q{ m: { "k": 2 } }}")
    let r = R{l: [1, 2] }
    println("r: {r == r} {r == R{ l: [1, 3] }}")
    let n = N{ p: p, r: r }
    println("nested: {n == N{ p: p2, r: R{ l: [1, 2] }}} {n == N{ p: p2, r: R{ l: [9] }}}")
    println("enum: {E.C("a", 1) == E.C("a", 1)} {E.C("a", 1) == E.C("a", 2)}")
    let o1: ?Int = 5
    let o2: ?Int = 5
    let o3: ?Int = nil
    println("opt: {o1 == o2} {o1 == o3} {o3 == nil}")
    println("list of structs: {[p, p2] == [p2, p]} {[p] == [P{ a: 9, b: "x" }]}")
}
