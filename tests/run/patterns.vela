// EXPECT:
// circle 2.0
// rect 3.0x4.0
// empty
// small
// medium
// large
// bound 7
// nil-case
// some 3
// ok 5
// err oops
// struct 1 2
fn main() {
    for s in [Shape.Circle(2.0), Shape.Rect(3.0, 4.0), Shape.Empty] {
        println(describe(s))
    }
    for n in [1, 50, 500] {
        println(size(n))
    }
    println(bind(7))
    let a: ?Int = nil
    let b: ?Int = 3
    println(opt(a))
    println(opt(b))
    println(res(ok(5)))
    println(res(err("oops")))
    let p = Point{ x: 1, y: 2 }
    println(match p{ Point{ x: a, y: b } => "struct {a} {b}" })
}
struct Point {
    x: Int,
    y: Int,
}
enum Shape {
    Circle(Float),
    Rect(Float,
    Float),
    Empty,
}
fn describe(s: Shape) -> Str {
    return match s {
        Shape.Circle(r) => "circle {r}",
        Shape.Rect(w, h) => "rect {w}x{h}",
        Shape.Empty => "empty",
    }
}
fn size(n: Int) -> Str {
    return match n {
        1 | 2 | 3 => "small",
        _ if n < 100 => "medium",
        _ => "large",
    }
}
fn bind(n: Int) -> Str {
    return match n {
        v => "bound {v}",
    }
}
fn opt(o: ?Int) -> Str {
    return match o {
        nil => "nil-case",
        some(v) => "some {v}",
    }
}
fn res(r: !Int) -> Str {
    return match r {
        ok(v) => "ok {v}",
        err(e) => "err {e.msg}",
    }
}
