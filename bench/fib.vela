// Deep recursion and integer arithmetic.
use std/os
use std/time
fn fib(n: Int) -> Int {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}
fn main() {
    let argv = os.args()
    let n = if len(argv) > 1{argv[1].to_int() ?? 32} else {32}
    let t0 = time.mono_ns()
    let v = fib(n)
    let el = time.mono_ns() - t0
    println("fib({n}) = {v} in {time.duration_str(el)}")
}
