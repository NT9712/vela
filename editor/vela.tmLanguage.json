{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vela",
  "scopeName": "source.vela",
  "fileTypes": ["vela"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#intrinsics" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.documentation.vela", "match": "///.*$" },
        { "name": "comment.line.double-slash.vela", "match": "//.*$" },
        { "name": "comment.block.vela", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.vela",
          "begin": "\"", "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.vela", "match": "\\\\(n|r|t|0|\\\\|\"|'|\\{|\\}|x[0-9a-fA-F]{2})" },
            { "name": "meta.embedded.vela", "begin": "\\{", "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.section.embedded.vela" } },
              "endCaptures":   { "0": { "name": "punctuation.section.embedded.vela" } },
              "patterns": [ { "include": "$self" } ] }
          ]
        },
        { "name": "string.quoted.single.vela", "match": "'([^'\\\\]|\\\\.)'" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.vela", "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*([eE][-+]?\\d+)?\\b" },
        { "name": "constant.numeric.hex.vela", "match": "\\b0[xX][0-9a-fA-F_]+\\b" },
        { "name": "constant.numeric.bin.vela", "match": "\\b0[bB][01_]+\\b" },
        { "name": "constant.numeric.oct.vela", "match": "\\b0[oO][0-7_]+\\b" },
        { "name": "constant.numeric.integer.vela", "match": "\\b\\d[\\d_]*\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.vela", "match": "\\b(if|else|match|while|for|in|break|continue|return)\\b" },
        { "name": "keyword.declaration.vela", "match": "\\b(fn|let|mut|const|type|struct|enum|use|as|pub|test)\\b" },
        { "name": "keyword.operator.word.vela", "match": "\\b(and|or|not)\\b" },
        { "name": "constant.language.vela", "match": "\\b(true|false|nil|void)\\b" },
        { "name": "variable.language.vela", "match": "\\bself\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.vela", "match": "\\b(Int|Float|Bool|Byte|Str|Void|Range|Error|List|Map)\\b" },
        { "name": "entity.name.type.vela", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "functions": {
      "patterns": [
        { "name": "entity.name.function.vela", "match": "(?<=\\bfn\\s)[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)?" },
        { "name": "support.function.builtin.vela", "match": "\\b(str|int|float|byte|bool|len|print|println|panic|assert|assert_eq|assert_ne|ok|err|err_code)\\b(?=\\()" },
        { "name": "entity.name.function.call.vela", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\()" }
      ]
    },
    "intrinsics": {
      "patterns": [ { "name": "keyword.other.intrinsic.vela", "match": "@[A-Za-z_][A-Za-z0-9_]*" } ]
    },
    "operators": {
      "patterns": [ { "name": "keyword.operator.vela", "match": "(\\?\\?|->|=>|==|!=|<=|>=|<<|>>|\\.\\.=|\\.\\.|[-+*/%<>=!&|^~?])" } ]
    }
  }
}
