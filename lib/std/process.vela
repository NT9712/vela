// std/process — running child processes.

use core
use core/sys

fn cstr(s: Str) -> Int {
    let p = core.str_alloc(len(s) + 1)
    core.mcopy(p + 16, @addr(s) + 16, len(s))
    @store8(p + 16 + len(s), 0)
    return p + 16
}

fn argv_block(args: [Str]) -> Int {
    let n = len(args)
    let blk = core.alloc(16 + (n + 1) * 8, 0) + 16
    for i, a in args {
        @store64(blk + i * 8, cstr(a))
    }
    @store64(blk + n * 8, 0)
    return blk
}

/// What a finished child process produced.
pub struct Output {
    status: Int,
    stdout: Str,
    stderr: Str,
}

/// Run `args` and wait for it, capturing standard output and standard error.
pub fn run(args: [Str]) -> !Output {
    if len(args) == 0 {
        return err("process.run needs at least a program name")
    }
    let outp = core.alloc(32, 0) + 16
    let errp = core.alloc(32, 0) + 16
    if sys.pipe(outp) != 0 {
        return err("cannot create pipe")
    }
    if sys.pipe(errp) != 0 {
        return err("cannot create pipe")
    }
    let out_r = @load32(outp)
    let out_w = @load32(outp + 4)
    let err_r = @load32(errp)
    let err_w = @load32(errp + 4)

    let pid = sys.fork()
    if pid < 0 {
        return err("fork failed")
    }
    if pid == 0 {
        sys.close(out_r)
        sys.close(err_r)
        sys.dup2(out_w, 1)
        sys.dup2(err_w, 2)
        sys.close(out_w)
        sys.close(err_w)
        @syscall(sys.SYS_EXECVE, cstr(args[0]), argv_block(args), @envp())
        core.exit(127)
    }
    sys.close(out_w)
    sys.close(err_w)
    let so = drain(out_r)
    let se = drain(err_r)
    sys.close(out_r)
    sys.close(err_r)
    let stat = core.alloc(32, 0) + 16
    @syscall(sys.SYS_WAIT4, pid, stat, 0, 0)
    let raw = @load32(stat)
    let mut code = (raw >> 8) & 255
    if raw & 127 != 0 {
        code = 128 + (raw & 127)
    }
    return ok(Output{ status: code, stdout: so, stderr: se })
}

fn drain(fd: Int) -> Str {
    let mut out = ""
    let bufsz = 65536
    let p = core.str_alloc(bufsz)
    while true {
        let got = sys.read(fd, p + 16, bufsz)
        if got <= 0 {
            return out
        }
        out = out + core.str_from(p + 16, got)
    }
    return out
}

/// Run a program, inheriting the parent's streams; returns its exit status.
pub fn spawn(args: [Str]) -> !Int {
    if len(args) == 0 {
        return err("process.spawn needs at least a program name")
    }
    let pid = sys.fork()
    if pid < 0 {
        return err("fork failed")
    }
    if pid == 0 {
        @syscall(sys.SYS_EXECVE, cstr(args[0]), argv_block(args), @envp())
        core.exit(127)
    }
    let stat = core.alloc(32, 0) + 16
    @syscall(sys.SYS_WAIT4, pid, stat, 0, 0)
    let raw = @load32(stat)
    let mut code = (raw >> 8) & 255
    if raw & 127 != 0 {
        code = 128 + (raw & 127)
    }
    return ok(code)
}

/// Look `name` up on PATH. Returns the absolute path, or nil.
pub fn which(name: Str) -> ?Str {
    if name.contains("/") {
        return name
    }
    let p = env_path()
    for dir in p.split(":") {
        if len(dir) == 0 {
            continue
        }
        let cand = dir + "/" + name
        let buf = core.alloc(sys.STAT_SIZE, 0)
        let c = core.str_alloc(len(cand) + 1)
        core.mcopy(c + 16, @addr(cand) + 16, len(cand))
        @store8(c + 16 + len(cand), 0)
        if sys.stat(c + 16, buf) == 0 {
            return cand
        }
    }
    return nil
}

fn env_path() -> Str {
    let e = @envp()
    let mut i = 0
    while true {
        let q = @load64(e + i * 8)
        if q == 0 {
            return "/usr/bin:/bin"
        }
        let mut l = 0
        while @load8(q + l) != 0 {
            l += 1
        }
        let s = core.str_from(q, l)
        if s.starts_with("PATH=") {
            return s[5..len(s)]
        }
        i += 1
    }
    return "/usr/bin:/bin"
}

/// Send a signal to a process.
pub fn kill(pid: Int, sig: Int) -> !Void {
    if @syscall(sys.SYS_KILL, pid, sig) != 0 {
        return err("cannot signal process {pid}")
    }
    return ok(void)
}
