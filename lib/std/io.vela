// std/io — console and stream input/output.

use core
use core/sys

pub const STDIN: Int = 0
pub const STDOUT: Int = 1
pub const STDERR: Int = 2

/// Write `s` to standard output.
pub fn print(s: Str) {
    core.print_str(s)
}

/// Write `s` and a newline to standard output.
pub fn println(s: Str) {
    core.print_str(s)
    core.print_str("\n")
}

/// Write `s` to standard error.
pub fn eprint(s: Str) {
    core.eprint_str(s)
}

/// Write `s` and a newline to standard error.
pub fn eprintln(s: Str) {
    core.eprint_str(s)
    core.eprint_str("\n")
}

/// Write raw bytes to a file descriptor. Returns the number written.
pub fn write(fd: Int, s: Str) -> Int {
    return core.sys_write(fd, @addr(s) + 16, len(s))
}

/// Read up to `n` bytes from `fd`. Returns an empty string at end of file.
pub fn read(fd: Int, n: Int) -> Str {
    let p = core.str_alloc(n)
    let got = sys.read(fd, p + 16, n)
    if got <= 0 {
        return ""
    }
    @store64(p + 8, got)
    return @ref[Str](p)
}

/// Read one line from standard input, without the trailing newline.
/// Returns nil at end of file.
pub fn read_line() -> ?Str {
    return core.stdin_line()
}

/// Read all of standard input.
pub fn read_all() -> Str {
    return core.stdin_all()
}

/// Read exactly `n` bytes from standard input (fewer at end of file).
pub fn read_exact(n: Int) -> Str {
    return core.stdin_exact(n)
}

/// Flush is a no-op: Vela's output is unbuffered and every write is a syscall.
pub fn flush() {}
