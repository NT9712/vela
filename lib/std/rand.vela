// std/rand — deterministic pseudo-random numbers (xoshiro256**).

use core
use core/sys

const RS: Int = 400 // runtime scratch offset for the generator state

fn st(i: Int) -> Int {
    return @load64(@rt_base() + RS + i * 8)
}
fn sst(i: Int, v: Int) {
    @store64(@rt_base() + RS + i * 8, v)
}

fn rotl(x: Int, k: Int) -> Int {
    return ((x << k) | ((x >> (64 - k)) & ((1 << k) - 1)))
}

fn ensure_seeded() {
    if st(0) == 0 and st(1) == 0 and st(2) == 0 and st(3) == 0 {
        seed(0x9E3779B97F4A7C15)
    }
}

/// Seed the generator. The same seed always produces the same sequence.
pub fn seed(s: Int) {
    let mut x = s
    if x == 0 {
        x = 1
    }
    for i in 0..4 {
        x = x + -7046029254386353131
        let mut z = x
        z = (z ^ ((z >> 30) & 0x3FFFFFFFF)) * -4658895280553007687
        z = (z ^ ((z >> 27) & 0x1FFFFFFFFFF)) * -7723592293110705685
        z = z ^ ((z >> 31) & 0x1FFFFFFFF)
        sst(i, z)
    }
}

/// Seed from the clock.
pub fn seed_from_clock() {
    seed(sys.clock_ns(0))
}

/// The next 64-bit value.
pub fn next() -> Int {
    ensure_seeded()
    let s0 = st(0)
    let mut s1 = st(1)
    let s2 = st(2) ^ s0
    let s3 = st(3) ^ s1
    let r = rotl(s1 * 5, 7) * 9
    sst(0, s0 ^ s3)
    sst(1, s1 ^ s2)
    sst(2, s2 ^ (s1 << 17))
    sst(3, rotl(s3, 45))
    return r
}

/// A non-negative integer below `n`.
pub fn int_below(n: Int) -> Int {
    if n <= 0 {
        return 0
    }
    let v = next() & 0x7FFFFFFFFFFFFFFF
    return v % n
}

/// An integer in `lo..hi` (upper bound exclusive).
pub fn range(lo: Int, hi: Int) -> Int {
    if hi <= lo {
        return lo
    }
    return lo + int_below(hi - lo)
}

/// A float in [0, 1).
pub fn float01() -> Float {
    let v = (next() >> 11) & 0x1FFFFFFFFFFFFF
    return float(v) / 9007199254740992.0
}

/// True with probability `p`.
pub fn chance(p: Float) -> Bool {
    return float01() < p
}

/// Shuffle a list in place.
pub fn shuffle[T](xs: [T]) {
    let n = len(xs)
    let mut i = n - 1
    while i > 0 {
        let j = int_below(i + 1)
        let t = xs[i]
        xs[i] = xs[j]
        xs[j] = t
        i -= 1
    }
}

/// A random element, or nil when the list is empty.
pub fn pick[T](xs: [T]) -> ?T {
    if len(xs) == 0 {
        return nil
    }
    return xs[int_below(len(xs))]
}
