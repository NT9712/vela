// std/net — TCP sockets over raw syscalls.

use core
use core/sys

/// A connected TCP stream.
pub struct Conn {
    fd: Int,
}

/// A listening TCP socket.
pub struct Listener {
    fd: Int,
    port: Int,
}

fn sockaddr(ip: Int, port: Int) -> Int {
    let a = core.alloc(32, 0) + 16
    @store16(a, sys.AF_INET)
    @store8(a + 2, (port >> 8) & 255)
    @store8(a + 3, port & 255)
    @store32(a + 4, ip)
    return a
}

/// Parse dotted-quad IPv4 into the network-order word the kernel expects.
pub fn parse_ip(s: Str) -> ?Int {
    let parts = s.split(".")
    if len(parts) != 4 {
        return nil
    }
    let mut v = 0
    let mut shift = 0
    for p in parts {
        let n = p.to_int() ?? return nil
        if n < 0 or n > 255 {
            return nil
        }
        v = v | (n << shift)
        shift += 8
    }
    return v
}

/// Connect to `host:port`. `host` must be a dotted-quad address.
pub fn connect(host: Str, port: Int) -> !Conn {
    let ip = parse_ip(host) ?? return err("net.connect needs a dotted-quad address, got '{host}'")
    sys.net_init()
    let fd = sys.socket_tcp()
    if fd < 0 {
        return err("cannot create socket")
    }
    if sys.connect(fd, sockaddr(ip, port), 16) < 0 {
        sys.close(fd)
        return err("cannot connect to {host}:{port}")
    }
    return ok(Conn{fd: fd})
}

/// Listen on `port` for incoming connections.
pub fn listen(port: Int) -> !Listener {
    sys.net_init()
    let fd = sys.socket_tcp()
    if fd < 0 {
        return err("cannot create socket")
    }
    sys.reuse_addr(fd)
    if sys.bind(fd, sockaddr(0, port), 16) < 0 {
        sys.close(fd)
        return err("cannot bind port {port}")
    }
    if sys.listen(fd, 128) < 0 {
        sys.close(fd)
        return err("cannot listen on port {port}")
    }
    return ok(Listener{ fd: fd, port: port })
}

/// Accept one connection, blocking until a client arrives.
pub fn Listener.accept(self) -> !Conn {
    let fd = sys.accept(self.fd)
    if fd < 0 {
        return err("accept failed")
    }
    return ok(Conn{fd: fd})
}

/// Stop listening.
pub fn Listener.close(self) {
    sys.sock_close(self.fd)
}

/// Send a string. Returns the number of bytes written.
pub fn Conn.write(self, s: Str) -> !Int {
    let n = len(s)
    let mut off = 0
    while off < n {
        let w = sys.sock_send(self.fd, @addr(s) + 16 + off, n - off)
        if w <= 0 {
            return err("write failed")
        }
        off += w
    }
    return ok(n)
}

/// Read up to `n` bytes. An empty string means the peer closed the connection.
pub fn Conn.read(self, n: Int) -> Str {
    let p = core.str_alloc(n)
    let got = sys.sock_recv(self.fd, p + 16, n)
    if got <= 0 {
        return ""
    }
    @store64(p + 8, got)
    return @ref[Str](p)
}

/// Read until the peer closes.
pub fn Conn.read_all(self) -> Str {
    let mut out = ""
    while true {
        let c = self.read(65536)
        if len(c) == 0 {
            return out
        }
        out = out + c
    }
    return out
}

/// Read until `marker` appears, returning everything up to and including it.
pub fn Conn.read_until(self, marker: Str) -> Str {
    let mut out = ""
    while true {
        let c = self.read(4096)
        if len(c) == 0 {
            return out
        }
        out = out + c
        if out.contains(marker) {
            return out
        }
    }
    return out
}

/// Close the connection.
pub fn Conn.close(self) {
    sys.sock_close(self.fd)
}
