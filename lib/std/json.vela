// std/json — JSON parsing and serialisation.

use core

/// A JSON value.
pub enum Json {
    Null,
    Bool(Bool),
    Num(Float),
    Str(Str),
    List([Json]),
    Obj({Str: Json}),
}

struct P {
    s: Str,
    i: Int,
}

/// Parse a JSON document.
pub fn parse(text: Str) -> !Json {
    let p = P{ s: text, i: 0 }
    p.ws()
    let v = p.value()?
    p.ws()
    if p.i < len(p.s) {
        return err("trailing characters at byte {p.i}")
    }
    return ok(v)
}

fn P.ws(self) {
    while self.i < len(self.s) {
        let c = self.s[self.i]
        if c == ' ' or c == '\t' or c == '\n' or c == '\r' {
            self.i += 1
        } else {
            return
        }
    }
}

fn P.value(self) -> !Json {
    if self.i >= len(self.s) {
        return err("unexpected end of input")
    }
    let c = self.s[self.i]
    if c == '{' {
        return self.object()
    }
    if c == '[' {
        return self.array()
    }
    if c == '"' {
        return ok(Json.Str(self.string()?))
    }
    if c == 't' {
        self.expect("true")?
        return ok(Json.Bool(true))
    }
    if c == 'f' {
        self.expect("false")?
        return ok(Json.Bool(false))
    }
    if c == 'n' {
        self.expect("null")?
        return ok(Json.Null)
    }
    return self.number()
}

fn P.expect(self, w: Str) -> !Void {
    if self.i + len(w) > len(self.s) or self.s[self.i..self.i + len(w)] != w {
        return err("expected '{w}' at byte {self.i}")
    }
    self.i += len(w)
    return ok(void)
}

fn P.string(self) -> !Str {
    self.i += 1
    let mut out = ""
    while self.i < len(self.s) {
        let c = self.s[self.i]
        if c == '"' {
            self.i += 1
            return ok(out)
        }
        if c == '\\' {
            self.i += 1
            if self.i >= len(self.s) {
                return err("unterminated escape")
            }
            let e = self.s[self.i]
            self.i += 1
            if e == 'n' {
                out = out + "\n"
            } else if e == 't' {
                out = out + "\t"
            } else if e == 'r' {
                out = out + "\r"
            } else if e == 'b' {
                out = out + "\x08"
            } else if e == 'f' {
                out = out + "\x0c"
            } else if e == 'u' {
                if self.i + 4 > len(self.s) {
                    return err("truncated \\u escape")
                }
                let hex = self.s[self.i..self.i + 4]
                self.i += 4
                out = out + utf8(hex_val(hex))
            } else {
                out = out + e.str()
            }
            continue
        }
        out = out + c.str()
        self.i += 1
    }
    return err("unterminated string")
}

fn hex_val(h: Str) -> Int {
    let mut v = 0
    for c in h {
        v = v * 16
        if c >= '0' and c <= '9' {
            v += int(c) - 48
        } else if c >= 'a' and c <= 'f' {
            v += int(c) - 87
        } else if c >= 'A' and c <= 'F' {
            v += int(c) - 55
        }
    }
    return v
}

fn utf8(cp: Int) -> Str {
    if cp < 128 {
        return byte(cp).str()
    }
    if cp < 2048 {
        return byte(192 | (cp >> 6)).str() + byte(128 | (cp & 63)).str()
    }
    return byte(224 | (cp >> 12)).str() + byte(128 | ((cp >> 6) & 63)).str() +
        byte(128 | (cp & 63)).str()
}

fn P.number(self) -> !Json {
    let start = self.i
    if self.i < len(self.s) and self.s[self.i] == '-' {
        self.i += 1
    }
    while self.i < len(self.s) {
        let c = self.s[self.i]
        if c.is_digit() or c == '.' or c == 'e' or c == 'E' or c == '+' or c == '-' {
            self.i += 1
        } else {
            break
        }
    }
    if self.i == start {
        return err("expected a value at byte {start}")
    }
    let t = self.s[start..self.i]
    if let f = t.to_float() {
        return ok(Json.Num(f))
    }
    return err("bad number '{t}'")
}

fn P.array(self) -> !Json {
    self.i += 1
    let items: [Json] = []
    self.ws()
    if self.i < len(self.s) and self.s[self.i] == ']' {
        self.i += 1
        return ok(Json.List(items))
    }
    while true {
        self.ws()
        items.push(self.value()?)
        self.ws()
        if self.i >= len(self.s) {
            return err("unterminated array")
        }
        let c = self.s[self.i]
        self.i += 1
        if c == ']' {
            return ok(Json.List(items))
        }
        if c != ',' {
            return err("expected ',' or ']' at byte {self.i - 1}")
        }
    }
    return err("unreachable")
}

fn P.object(self) -> !Json {
    self.i += 1
    let obj: {Str: Json} = {:}
    self.ws()
    if self.i < len(self.s) and self.s[self.i] == '}' {
        self.i += 1
        return ok(Json.Obj(obj))
    }
    while true {
        self.ws()
        if self.i >= len(self.s) or self.s[self.i] != '"' {
            return err("expected a key at byte {self.i}")
        }
        let k = self.string()?
        self.ws()
        if self.i >= len(self.s) or self.s[self.i] != ':' {
            return err("expected ':' at byte {self.i}")
        }
        self.i += 1
        self.ws()
        obj[k] = self.value()?
        self.ws()
        if self.i >= len(self.s) {
            return err("unterminated object")
        }
        let c = self.s[self.i]
        self.i += 1
        if c == '}' {
            return ok(Json.Obj(obj))
        }
        if c != ',' {
            return err("expected ',' or '}}' at byte {self.i - 1}")
        }
    }
    return err("unreachable")
}

// --------------------------------------------------------------- accessors

/// The value at `key`, when this is an object.
pub fn Json.get(self, key: Str) -> ?Json {
    return match self {
        Json.Obj(m) => m[key],
        _ => nil,
    }
}

/// The element at `i`, when this is an array.
pub fn Json.at(self, i: Int) -> ?Json {
    return match self {
        Json.List(xs) => list_at(xs, i),
        _ => nil,
    }
}

fn list_at(xs: [Json], i: Int) -> ?Json {
    if i < 0 or i >= len(xs) {
        return nil
    }
    return xs[i]
}

/// The string contents, when this is a string.
pub fn Json.as_str(self) -> ?Str {
    return match self {
        Json.Str(s) => s,
        _ => nil,
    }
}

/// The numeric value, when this is a number.
pub fn Json.as_float(self) -> ?Float {
    return match self {
        Json.Num(f) => f,
        _ => nil,
    }
}

/// The numeric value truncated to an integer.
pub fn Json.as_int(self) -> ?Int {
    return match self {
        Json.Num(f) => int(f),
        _ => nil,
    }
}

/// The boolean value, when this is a boolean.
pub fn Json.as_bool(self) -> ?Bool {
    return match self {
        Json.Bool(b) => b,
        _ => nil,
    }
}

// ------------------------------------------------------------- serialising

/// Compact JSON text.
pub fn Json.to_str(self) -> Str {
    return match self {
        Json.Null => "null",
        Json.Bool(b) => str(b),
        Json.Num(f) => num_str(f),
        Json.Str(s) => quote(s),
        Json.List(xs) => list_str(xs),
        Json.Obj(m) => obj_str(m),
    }
}

fn list_str(xs: [Json]) -> Str {
    let parts: [Str] = []
    for x in xs {
        parts.push(x.to_str())
    }
    return "[" + parts.join(",") + "]"
}

fn obj_str(m: {Str: Json}) -> Str {
    let keys = m.keys()
    keys.sort_by(| a: Str, b: Str | a < b)
    let parts: [Str] = []
    for k in keys {
        if let v = m[k] {
            parts.push(quote(k) + ":" + v.to_str())
        }
    }
    return "{{" + parts.join(",") + "}}"
}

/// Indented, human-readable JSON text.
pub fn Json.pretty(self) -> Str {
    return self.pretty_at(0)
}

fn Json.pretty_at(self, depth: Int) -> Str {
    let pad = "  ".repeat(depth)
    let pad2 = "  ".repeat(depth + 1)
    return match self {
        Json.List(xs) => list_pretty(xs, pad, pad2, depth),
        Json.Obj(m) => obj_pretty(m, pad, pad2, depth),
        _ => self.to_str(),
    }
}

fn list_pretty(xs: [Json], pad: Str, pad2: Str, depth: Int) -> Str {
    if len(xs) == 0 {
        return "[]"
    }
    let parts: [Str] = []
    for x in xs {
        parts.push(pad2 + x.pretty_at(depth + 1))
    }
    return "[\n" + parts.join(",\n") + "\n" + pad + "]"
}

fn obj_pretty(m: {Str: Json}, pad: Str, pad2: Str, depth: Int) -> Str {
    let keys = m.keys()
    keys.sort_by(| a: Str, b: Str | a < b)
    if len(keys) == 0 {
        return "{{}}"
    }
    let parts: [Str] = []
    for k in keys {
        if let v = m[k] {
            parts.push(pad2 + quote(k) + ": " + v.pretty_at(depth + 1))
        }
    }
    return "{{\n" + parts.join(",\n") + "\n" + pad + "}}"
}

fn num_str(f: Float) -> Str {
    let n = int(f)
    if float(n) == f {
        return str(n)
    }
    return str(f)
}

fn quote(s: Str) -> Str {
    let mut out = "\""
    for c in s {
        if c == '"' {
            out = out + "\\\""
        } else if c == '\\' {
            out = out + "\\\\"
        } else if c == '\n' {
            out = out + "\\n"
        } else if c == '\t' {
            out = out + "\\t"
        } else if c == '\r' {
            out = out + "\\r"
        } else if int(c) < 32 {
            out = out + "\\u00" + hex2(int(c))
        } else {
            out = out + c.str()
        }
    }
    return out + "\""
}

fn hex2(v: Int) -> Str {
    let digits = "0123456789abcdef"
    return digits[v / 16..v / 16 + 1] + digits[v % 16..v % 16 + 1]
}
