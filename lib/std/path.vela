// std/path — textual path manipulation. No filesystem access.

/// Join path segments with `/`, skipping empty pieces.
pub fn join(parts: [Str]) -> Str {
    let mut out = ""
    for p in parts {
        if len(p) == 0 {
            continue
        }
        if len(out) == 0 {
            out = p
        } else if out.ends_with("/") {
            out = out + p
        } else {
            out = out + "/" + p
        }
    }
    return out
}

/// Everything before the last `/`, or "." when there is none.
pub fn dir(p: Str) -> Str {
    let i = last_slash(p)
    if i < 0 {
        return "."
    }
    if i == 0 {
        return "/"
    }
    return p[0..i]
}

/// Everything after the last `/`.
pub fn base(p: Str) -> Str {
    let i = last_slash(p)
    if i < 0 {
        return p
    }
    return p[i + 1..len(p)]
}

/// The extension including the dot, or "" when there is none.
pub fn ext(p: Str) -> Str {
    let b = base(p)
    let mut i = len(b) - 1
    while i > 0 {
        if b[i] == '.' {
            return b[i..len(b)]
        }
        i -= 1
    }
    return ""
}

/// The base name without its extension.
pub fn stem(p: Str) -> Str {
    let b = base(p)
    let e = ext(b)
    return b[0..len(b) - len(e)]
}

/// True when the path starts at the filesystem root.
pub fn is_absolute(p: Str) -> Bool {
    return p.starts_with("/")
}

/// Collapse `.` and `..` segments.
pub fn normalize(p: Str) -> Str {
    let abs = is_absolute(p)
    let out: [Str] = []
    for seg in p.split("/") {
        if len(seg) == 0 or seg == "." {
            continue
        }
        if seg == ".." {
            if len(out) > 0 and out[len(out) - 1] != ".." {
                out.pop()
            } else if not abs {
                out.push("..")
            }
            continue
        }
        out.push(seg)
    }
    let joined = out.join("/")
    if abs {
        return "/" + joined
    }
    if len(joined) == 0 {
        return "."
    }
    return joined
}

fn last_slash(p: Str) -> Int {
    let mut i = len(p) - 1
    while i >= 0 {
        if p[i] == '/' {
            return i
        }
        i -= 1
    }
    return -1
}
