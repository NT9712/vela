// core/sys — the Linux system-call layer for AArch64.
//
// The compiler resolves `use core/sys` to the file for the target it is
// building, so everything above this line is architecture independent.

pub const ARCH: Str = "arm64"

pub const SYS_READ: Int = 63
pub const SYS_WRITE: Int = 64
pub const SYS_CLOSE: Int = 57
pub const SYS_LSEEK: Int = 62
pub const SYS_MMAP: Int = 222
pub const SYS_MUNMAP: Int = 215
pub const SYS_IOCTL: Int = 29
pub const SYS_GETPID: Int = 172
pub const SYS_SOCKET: Int = 198
pub const SYS_CONNECT: Int = 203
pub const SYS_ACCEPT: Int = 202
pub const SYS_SHUTDOWN: Int = 210
pub const SYS_BIND: Int = 200
pub const SYS_LISTEN: Int = 201
pub const SYS_SETSOCKOPT: Int = 208
pub const SYS_EXECVE: Int = 221
pub const SYS_EXIT_GROUP: Int = 94
pub const SYS_WAIT4: Int = 260
pub const SYS_KILL: Int = 129
pub const SYS_GETCWD: Int = 17
pub const SYS_CHDIR: Int = 49
pub const SYS_NANOSLEEP: Int = 101
pub const SYS_CLOCK_GETTIME: Int = 113
pub const SYS_GETDENTS64: Int = 61

/// Byte offsets into `struct stat`, which differs between architectures.
pub const STAT_SIZE: Int = 160
pub const STAT_MODE_OFF: Int = 16
pub const STAT_SIZE_OFF: Int = 48

pub fn read(fd: Int, buf: Int, n: Int) -> Int {
    return @syscall(SYS_READ, fd, buf, n)
}

pub fn write(fd: Int, buf: Int, n: Int) -> Int {
    return @syscall(SYS_WRITE, fd, buf, n)
}

pub fn close(fd: Int) -> Int {
    return @syscall(SYS_CLOSE, fd)
}

pub fn mmap_anon(n: Int) -> Int {
    return @syscall(SYS_MMAP, 0, n, 3, 0x4022, -1, 0)
}

pub fn exit_group(code: Int) {
    @syscall(SYS_EXIT_GROUP, code)
}

// AArch64 dropped the plain forms of these calls; only the `*at` variants
// exist, so the wrappers pass AT_FDCWD and translate the flags.
const AT_FDCWD: Int = -100
const AT_REMOVEDIR: Int = 512

pub fn open(path: Int, flags: Int, mode: Int) -> Int {
    return @syscall(56, AT_FDCWD, path, flags, mode)
}

pub fn stat(path: Int, buf: Int) -> Int {
    return @syscall(79, AT_FDCWD, path, buf, 0)
}

pub fn unlink(path: Int) -> Int {
    return @syscall(35, AT_FDCWD, path, 0)
}

pub fn mkdir(path: Int, mode: Int) -> Int {
    return @syscall(34, AT_FDCWD, path, mode)
}

pub fn rmdir(path: Int) -> Int {
    return @syscall(35, AT_FDCWD, path, AT_REMOVEDIR)
}

pub fn rename(from: Int, to: Int) -> Int {
    return @syscall(38, AT_FDCWD, from, AT_FDCWD, to)
}

pub fn readlink(path: Int, buf: Int, n: Int) -> Int {
    return @syscall(78, AT_FDCWD, path, buf, n)
}

pub fn pipe(fds: Int) -> Int {
    return @syscall(59, fds, 0)
}

pub fn dup2(old: Int, new: Int) -> Int {
    return @syscall(24, old, new, 0)
}

pub fn fork() -> Int {
    // no `fork` on AArch64: clone(SIGCHLD, 0, 0, 0, 0)
    return @syscall(220, 17, 0, 0, 0, 0)
}
